{
  "name": "dsh-jev-router",
  "version": "0.1.0",
  "private": true,
  "description": "Optional session-pinned Jev model routing for DeepSeek Harness",
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "exports": { ".": "./dist/index.js" },
  "files": ["dist/index.js", "cordis.patch.yml", "examples/jev-policy.patch.yml", "README.md", "README.zh.md"],
