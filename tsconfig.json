{
  "extends": "../deepseek-harness/tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "allowJs": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src", "tests"],
  "references": [
    { "path": "../deepseek-harness/vendor/cordis" },
    { "path": "../deepseek-harness/vendor/cosmokit" },
    { "path": "../deepseek-harness/vendor/schemastery" },
    { "path": "../deepseek-harness/vendor/loader" },
    { "path": "../deepseek-harness/vendor/include" }
  ]
}
